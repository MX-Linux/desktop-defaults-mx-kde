# PKGBUILD for building on the Open Build Service.
#
# This package is not in AUR and has no committed source tarball, so the OBS
# tar_scm service packs the checkout into one. That tarball has a constant name
# rather than a versioned one, so pkgver here is free to track debian/changelog
# and a release does not require editing the OBS service as well.
#
# Until now this package shipped only as a prebuilt file dropped onto the
# MX-Arch KDE ISO, so an installed system could never receive an update. This
# recipe is the whole build; the repository has no other PKGBUILD.
#
# The payload is derived from debian/install, which is the only thing
# debian/rules ships (it is a plain "dh $@" with no overrides).

# Maintainer: dolphinoracle <dolphinoracle@gmail.com>
pkgname=desktop-defaults-mx-kde
pkgver=26.05.01mx25
pkgrel=1
pkgdesc="Desktop defaults for MX Linux KDE/Plasma"
arch=('any')
url="https://github.com/MX-Linux/desktop-defaults-mx-kde"
# GPL2 for the package itself; the bundled monochrome SDDM theme is MIT.
license=('GPL2' 'MIT')
# Debian depends on sddm-theme-breeze and sonnet6-plugins. Arch has no
# standalone breeze SDDM theme package (the theme lives inside plasma-desktop),
# so that one is dropped rather than pulling a whole desktop in; breeze/ here is
# only a theme.conf.user override for it. sonnet6-plugins maps to sonnet, which
# ships the spell-check backends unsplit.
depends=('sonnet')
makedepends=()
source=("${pkgname}-source.tar")
sha256sums=('SKIP')

# tar_scm unpacks to <repository>-<versionformat>; both are fixed here.
_srcdir="${pkgname}-source"
md5sums=()
PKGEXT='.pkg.tar.zst'

package() {
    cd "${srcdir}/${_srcdir}"

    # debian/install: "skel etc" -> /etc/skel
    # Copied with a trailing /. so the dotfile trees (.config, .local) come too.
    install -dm755 "$pkgdir/etc/skel"
    cp -r skel/. "$pkgdir/etc/skel/"

    # debian/install: "sddm/* usr/share/desktop-defaults-mx-kde/sddm"
    # The pristine copy the Debian postinst restores from.
    install -Dm755 sddm/wayland-session \
        "$pkgdir/usr/share/desktop-defaults-mx-kde/sddm/wayland-session"

    # debian/install: "sddm/* etc/sddm"
    # Executed by SDDM, so it stays mode 755.
    install -Dm755 sddm/wayland-session "$pkgdir/etc/sddm/wayland-session"

    # debian/install: "xdg etc" -> /etc/xdg
    install -dm755 "$pkgdir/etc/xdg"
    install -m644 xdg/* "$pkgdir/etc/xdg/"

    # debian/install: "breeze usr/share/sddm/themes"
    # A theme.conf.user override dropped into the stock breeze SDDM theme.
    install -Dm644 breeze/theme.conf.user \
        "$pkgdir/usr/share/sddm/themes/breeze/theme.conf.user"

    # debian/install: "monochrome usr/share/sddm/themes"
    install -dm755 "$pkgdir/usr/share/sddm/themes"
    cp -r monochrome "$pkgdir/usr/share/sddm/themes/"
}
